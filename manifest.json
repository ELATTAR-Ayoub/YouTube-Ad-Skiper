{
  "manifest_version": 3,
  "name": "YouTube Skip Button Clicker",
  "version": "1.3.0",
  "description": "Configurable YouTube ad seeking and Skip clicks, with local skip counts and a rabbit popup.",
  "minimum_chrome_version": "96",
  "permissions": ["debugger", "storage"],
  "host_permissions": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/rabbit-16.png", "32": "icons/rabbit-32.png", "48": "icons/rabbit-48.png", "128": "icons/rabbit-128.png" },
  "action": {
    "default_title": "YouTube Skip Button Clicker",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/rabbit-16.png", "32": "icons/rabbit-32.png", "48": "icons/rabbit-48.png", "128": "icons/rabbit-128.png" }
  },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://youtube.com/*", "https://m.youtube.com/*"],
    "js": ["find-skip.js", "tracker.js", "settings.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
